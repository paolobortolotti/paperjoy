{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "popup/scene.schema.json",
  "title": "Pop-up book scene",
  "description": "Describes a paper pop-up book. All lengths are millimetres on the page. Every page is seen from the reader: x runs left to right along the spine (0..page[0]); y runs top to bottom of the page as seen (0..page[1]). On the near page y=0 is the spine; on the far page y=page[1] is the spine. The engine computes every 3D position; the scene never contains 3D coordinates. Mirrors the hand-written validator in engine/popup-engine.js (Popup.validate), which is authoritative.",
  "type": "object",
  "required": ["book", "spreads"],
  "additionalProperties": false,
  "properties": {
    "book": {
      "type": "object",
      "required": ["title", "page"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "page": { "description": "[width along spine, depth from spine] in mm", "type": "array", "items": { "type": "number", "minimum": 80, "maximum": 400 }, "minItems": 2, "maxItems": 2 },
        "cover": { "$ref": "#/$defs/color", "description": "Cover board colour" },
        "view": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pitch": { "type": "number", "minimum": 20, "maximum": 75, "description": "Camera elevation in degrees (default 42)" },
            "yaw": { "type": "number", "minimum": -35, "maximum": 35, "description": "Camera turn in degrees (default 0)" }
          }
        }
      }
    },
    "spreads": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/spread" }
    }
  },
  "$defs": {
    "color": {
      "description": "Fixed palette. Hex colours are rejected on purpose: the palette is part of the style.",
      "enum": ["paper", "cream", "ink", "terracotta", "brick", "ochre", "saffron", "rose", "peach", "sage", "olive", "pine", "sea", "deep", "sky", "slate", "stone"]
    },
    "art": {
      "description": "Layers drawn in face coordinates (mm, y down, origin at the top-left of the face as seen from its front). Painted in order.",
      "type": "array",
      "items": {
        "type": "object",
        "oneOf": [
          { "required": ["rect"], "properties": { "rect": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 }, "r": { "type": "number" }, "fill": { "$ref": "#/$defs/color" } } },
          { "required": ["path"], "properties": { "path": { "type": "string", "description": "SVG path data in mm" }, "fill": { "$ref": "#/$defs/color" }, "stroke": { "$ref": "#/$defs/color" }, "width": { "type": "number" } } },
          { "required": ["circle"], "properties": { "circle": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }, "fill": { "$ref": "#/$defs/color" } } },
          { "required": ["windows"], "properties": { "windows": { "type": "object", "required": ["x", "y", "cols", "rows"], "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "cols": { "type": "integer" }, "rows": { "type": "integer" }, "w": { "type": "number" }, "h": { "type": "number" }, "gx": { "type": "number" }, "gy": { "type": "number" }, "arch": { "type": "boolean" } } }, "fill": { "$ref": "#/$defs/color" }, "shutters": { "$ref": "#/$defs/color" } } },
          { "required": ["tiles"], "properties": { "tiles": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4, "description": "[x, y, w, h] area filled with roof-tile rows" }, "fill": { "$ref": "#/$defs/color" } } },
          { "required": ["waves"], "properties": { "waves": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4, "description": "[x, y, w, h] area filled with wave strokes" }, "fill": { "$ref": "#/$defs/color" } } },
          { "required": ["text"], "properties": { "text": { "type": "string" }, "x": { "type": "number" }, "y": { "type": "number" }, "size": { "type": "number" }, "fill": { "$ref": "#/$defs/color" }, "align": { "enum": ["left", "center", "right"] }, "font": { "enum": ["display", "text"], "description": "display: condensed capitals for headings and covers; text (default): sans for captions" }, "weight": { "type": "number", "description": "100..1000, text font only" }, "tracking": { "type": "number", "description": "letter spacing in em" }, "italic": { "type": "boolean" } } }
        ]
      }
    },
    "face": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": { "$ref": "#/$defs/color", "description": "Ground colour of the face" },
        "outline": { "type": "string", "description": "SVG path (face coordinates) of the cut silhouette. Default: the full face rectangle. On walls it may rise above the crease (y < 0): that part is cut out of the adjacent top panel, as in real paper." },
        "art": { "$ref": "#/$defs/art" },
        "back": { "$ref": "#/$defs/color", "description": "Colour of the reverse side (default paper)" }
      }
    },
    "spread": {
      "type": "object",
      "required": ["id", "near", "far"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "near": { "$ref": "#/$defs/face", "description": "Page nearest the reader (lower half of the open book)" },
        "far": { "$ref": "#/$defs/face", "description": "Page beyond the spine (upper half of the open book)" },
        "pieces": { "type": "array", "items": { "$ref": "#/$defs/piece" } }
      }
    },
    "piece": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string" },
        "type": { "enum": ["box", "step", "vfold", "slider", "flap", "wheel"] }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "box" } } },
          "then": {
            "description": "Parallel fold across the gutter. Front wall glued on the near page `near` mm from the spine, back wall glued on the far page `far` mm from the spine, both `height` tall; the top has a mountain crease over the spine. Folds flat when the book closes. Closed-fit rule: near + height <= page depth and far + height <= page depth.",
            "required": ["x", "near", "far", "height"],
            "properties": {
              "x": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
              "near": { "type": "number", "exclusiveMinimum": 0 },
              "far": { "type": "number", "exclusiveMinimum": 0 },
              "height": { "type": "number", "exclusiveMinimum": 0 },
              "faces": { "type": "object", "properties": { "front": { "$ref": "#/$defs/face" }, "top": { "$ref": "#/$defs/face" }, "topBack": { "$ref": "#/$defs/face" }, "back": { "$ref": "#/$defs/face" } }, "additionalProperties": false }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "step" } } },
          "then": {
            "description": "Parallel fold nested in the corner between a parent's wall and the floor it stands on. `parent` is a box or step id; `side` picks the corner (front: toward the reader, back: beyond the spine; a step inherits its parent's side). The new wall stands `out` mm in front of the parent wall and its top is glued on the parent wall `up` mm above the floor. up <= parent wall height. x must lie inside the parent's x.",
            "required": ["parent", "x", "out", "up"],
            "properties": {
              "parent": { "type": "string" },
              "side": { "enum": ["front", "back"] },
              "x": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
              "out": { "type": "number", "exclusiveMinimum": 0 },
              "up": { "type": "number", "exclusiveMinimum": 0 },
              "faces": { "type": "object", "properties": { "wall": { "$ref": "#/$defs/face" }, "top": { "$ref": "#/$defs/face" } }, "additionalProperties": false }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "vfold" } } },
          "then": {
            "description": "V-fold glued across the gutter. The crease starts on the spine at `x`; each half is glued along a line that leaves the spine at `angle` degrees and opens toward `dir`. The crease is perpendicular to the glue lines, so it stands vertical when the book lies open. Half size: `width` along the glue line, `height` along the crease.",
            "required": ["x", "angle", "dir", "width", "height"],
            "properties": {
              "x": { "type": "number" },
              "angle": { "type": "number", "minimum": 8, "maximum": 82 },
              "dir": { "enum": ["left", "right"] },
              "width": { "type": "number", "exclusiveMinimum": 0 },
              "farWidth": { "type": "number", "exclusiveMinimum": 0 },
              "height": { "type": "number", "exclusiveMinimum": 0 },
              "faces": { "type": "object", "properties": { "near": { "$ref": "#/$defs/face" }, "far": { "$ref": "#/$defs/face" } }, "additionalProperties": false }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "slider" } } },
          "then": {
            "description": "Flat piece riding a slot in a page, moved by a paper tab that sticks out of the page edge. The piece's top-left corner travels from track[0] to track[1] (page coordinates). The tab follows along the near edge.",
            "required": ["page", "size", "track"],
            "properties": {
              "page": { "enum": ["near", "far"] },
              "size": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
              "track": { "type": "array", "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }, "minItems": 2, "maxItems": 2 },
              "start": { "type": "number", "minimum": 0, "maximum": 1 },
              "tab": { "type": "object", "properties": { "label": { "type": "string" }, "color": { "$ref": "#/$defs/color" } } },
              "face": { "$ref": "#/$defs/face" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "flap" } } },
          "then": {
            "description": "Lift-the-flap. A flat piece hinged on a page along the line y (page coordinates) from x[0] to x[1]; it covers `length` mm below the hinge (side down) or above it (side up). Tapping it lifts it up to `open` degrees and shows its back face and the page art underneath. The closing book presses it flat. Front art as seen when closed; back art as seen when fully flipped (image top = free edge for side down, = hinge for side up).",
            "required": ["page", "x", "y", "length"],
            "properties": {
              "page": { "enum": ["near", "far"] },
              "x": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
              "y": { "type": "number" },
              "length": { "type": "number", "exclusiveMinimum": 0 },
              "side": { "enum": ["down", "up"] },
              "open": { "type": "number", "minimum": 10, "maximum": 180, "description": "Default 160" },
              "start": { "type": "number", "minimum": 0, "maximum": 1 },
              "faces": { "type": "object", "properties": { "front": { "$ref": "#/$defs/face" }, "back": { "$ref": "#/$defs/face" } }, "additionalProperties": false }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "wheel" } } },
          "then": {
            "description": "Volvelle: a paper disc riveted on a page at `center`, radius `r`. A grip tab on its rim lets the reader turn it. Art is drawn in [0, 2r] x [0, 2r], centre at (r, r); the grip sits at the top (angle 0). `steps` snaps it to n positions when released.",
            "required": ["page", "center", "r"],
            "properties": {
              "page": { "enum": ["near", "far"] },
              "center": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
              "r": { "type": "number", "minimum": 12 },
              "steps": { "type": "integer", "minimum": 2 },
              "start": { "type": "number", "description": "Initial angle in degrees, clockwise" },
              "window": { "type": "string", "description": "SVG path in page coordinates. The disc turns under the page and shows only through this hole (e.g. a half circle: day/night, seasons). Must lie over the disc. Without it the disc sits on top of the page with a grip on its rim." },
              "face": { "$ref": "#/$defs/face" }
            }
          }
        }
      ]
    }
  }
}
